# 全量 SQLite BM25 与全量 FAISS 使用同一批稳定 rowid。
MAX_LOADED_DOCUMENTS=20000
SEARCH_INDEX_PATH=
FAISS_INDEX_PATH=
FAISS_MANIFEST_PATH=
MODEL_CACHE_DIR=
BM25_TOP_K=100
VECTOR_TOP_K=100
RRF_TOP_K=40
FINAL_TOP_K=4
FAISS_NPROBE=32

# 默认模型均可通过环境变量替换；建库和查询必须使用相同 Embedding 模型。
EMBEDDING_MODEL=ming0302/bge-m3-medical-cn
EMBEDDING_MODEL_SUBFOLDER=model
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MODEL_DEVICE=auto
EMBEDDING_QUERY_MAX_LENGTH=128
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=8

# 可选 OpenAI 兼容接口；不要把真实密钥提交到仓库。
LLM_BASE_URL=https://llm-la37mu3daib29unw.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-ws-H.EDRHPHI.5luS.MEQCIHbW_q8Gg7oTgfBOPVjx3UKmEkySgT-EoBrMmG0IqCGeAiB58CoRUxEGbTDUo63jx46_Zs7Rv6hMuUNwb-m0KLBiww
LLM_MODEL=qwen3.7-plus

LLM_TIMEOUT_SECONDS=180
LLM_EVIDENCE_MAX_CHARACTERS=2500
LLM_MAX_OUTPUT_TOKENS=1200
# 通义千问等支持思考开关的兼容接口可设为 false；其他服务留空。
LLM_ENABLE_THINKING=
RETRIEVAL_LOG_TOP_K=10
RETRIEVAL_LOG_CONTENT_CHARACTERS=300
